{
  "name": "pisho",
  "version": "0.1.0",
  "description": "Pisho, a small animated desktop companion for Windows",
  "main": "main.js",
  "author": "Pisho",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pisho.app",
    "productName": "Pisho",
    "files": ["main.js", "preload.js", "renderer/**"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false },
    "artifactName": "Pisho-Setup-${version}.${ext}"
  }
}